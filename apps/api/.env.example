NODE_ENV=development

# API
PORT=4000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=voltis
DB_PASSWORD=voltis_dev_password
DB_NAME=voltis
DB_MIGRATIONS_RUN=false

# Redis (6383 avoids the common local Redis port 6379 collision)
REDIS_HOST=localhost
REDIS_PORT=6383
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_in_development
JWT_EXPIRES_IN=15m

# Internal worker authentication
WORKER_SECRET=change_this_worker_secret
