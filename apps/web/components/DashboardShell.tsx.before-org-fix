"use client";

import {
  Activity,
  ArrowDownLeft,
  ArrowUpRight,
  BarChart3,
  BookOpen,
  CheckCircle2,
  ChevronRight,
  CircleDollarSign,
  CreditCard,
  FileText,
  LayoutDashboard,
  LogOut,
  RefreshCw,
  Settings,
  ShieldCheck,
  SlidersHorizontal,
  Users,
  Webhook,
  XCircle,
} from "lucide-react";
import { useEffect, useMemo, useState } from "react";

import { useAuth } from "./AuthProvider";
import {
  api,
  type Account,
  type Organization,
  type Transaction,
  type TransactionsResponse,
} from "../lib/api";

type ActiveModule =
  | "Overview"
  | "Accounts"
  | "Transactions"
  | "Payments"
  | "Ledger"
  | "Reconciliation"
  | "Risk"
  | "Webhooks"
  | "Analytics"
  | "Settings";

const navigation: {
  section: string;
  items: { label: ActiveModule; icon: typeof LayoutDashboard }[];
}[] = [
  {
    section: "OPERATIONS",
    items: [
      { label: "Overview", icon: LayoutDashboard },
      { label: "Accounts", icon: Users },
      { label: "Transactions", icon: ArrowUpRight },
      { label: "Payments", icon: CreditCard },
      { label: "Ledger", icon: BookOpen },
      { label: "Reconciliation", icon: RefreshCw },
    ],
  },
  {
    section: "CONTROL",
    items: [
      { label: "Risk", icon: ShieldCheck },
      { label: "Webhooks", icon: Webhook },
      { label: "Analytics", icon: BarChart3 },
    ],
  },
];

function formatMoney(value: string | number, currency: string) {
  const amount = Number(value || 0);

  return `${currency} ${amount.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

function formatDate(value: string | null) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "—";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(date);
}

function statusClass(status: string) {
  const normalized = status.toLowerCase();

  if (
    ["completed", "success", "succeeded", "active", "allowed"].includes(
      normalized,
    )
  ) {
    return "status status-success";
  }

  if (
    ["failed", "rejected", "cancelled", "blocked", "inactive"].includes(
      normalized,
    )
  ) {
    return "status status-danger";
  }

  if (
    ["pending", "processing", "review"].includes(normalized)
  ) {
    return "status status-warning";
  }

  return "status";
}

function prettyStatus(status: string) {
  if (!status) return "Unknown";

  return status
    .replace(/[_-]/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

export default function DashboardShell() {
  const { user, loading: authLoading, logout } = useAuth();

  const [active, setActive] = useState<ActiveModule>("Overview");
  const [organization, setOrganization] =
    useState<Organization | null>(null);

  const [accounts, setAccounts] = useState<Account[]>([]);
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [transactionAnalytics, setTransactionAnalytics] =
    useState<TransactionsResponse | null>(null);

  const [loading, setLoading] = useState(true);
  const [moduleLoading, setModuleLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [theme, setTheme] = useState<"dark" | "light">("dark");

  useEffect(() => {
    const stored = window.localStorage.getItem("voltis_theme");

    if (stored === "light" || stored === "dark") {
      setTheme(stored);
    }
  }, []);

  useEffect(() => {
    document.documentElement.dataset.theme = theme;
    window.localStorage.setItem("voltis_theme", theme);
  }, [theme]);

  useEffect(() => {
    if (!user) {
      setLoading(false);
      return;
    }

    let cancelled = false;

    async function loadOrganization() {
      try {
        setLoading(true);
        setError(null);

        const organizations = await api.organizations.list();

        if (!cancelled) {
          setOrganization(organizations[0] ?? null);
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load organization.",
          );
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    loadOrganization();

    return () => {
      cancelled = true;
    };
  }, [user]);

  useEffect(() => {
    if (!organization || active !== "Accounts") return;

    let cancelled = false;

    async function loadAccounts() {
      try {
        setModuleLoading(true);
        setError(null);

        const data = await api.accounts.list(organizationId);

        if (!cancelled) {
          setAccounts(data);
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load accounts.",
          );
        }
      } finally {
        if (!cancelled) {
          setModuleLoading(false);
        }
      }
    }

    loadAccounts();

    return () => {
      cancelled = true;
    };
  }, [organization, active]);

  useEffect(() => {
    if (!organization || active !== "Transactions") return;

    let cancelled = false;

    async function loadTransactions() {
      try {
        setModuleLoading(true);
        setError(null);

        const [list, analytics] = await Promise.all([
          api.transactions.list(organizationId),
          api.transactions.analytics(organization.id),
        ]);

        if (!cancelled) {
          setTransactions(list);
          setTransactionAnalytics(analytics);
        }
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load transactions.",
          );
        }
      } finally {
        if (!cancelled) {
          setModuleLoading(false);
        }
      }
    }

    loadTransactions();

    return () => {
      cancelled = true;
    };
  }, [organization, active]);

  const transactionSummary = useMemo(() => {
    const statuses = transactionAnalytics?.byStatus ?? {};

    const findStatus = (names: string[]) =>
      names.reduce(
        (total, name) =>
          total +
          Number(
            statuses[name] ??
              statuses[name.toUpperCase()] ??
              statuses[name.toLowerCase()] ??
              0,
          ),
        0,
      );

    const completed = findStatus([
      "completed",
      "success",
      "succeeded",
    ]);

    const failed = findStatus([
      "failed",
      "rejected",
      "cancelled",
    ]);

    const pending = findStatus([
      "pending",
      "processing",
    ]);

    const volume =
      Object.entries(
        transactionAnalytics?.volumeByCurrency ?? {},
      )[0] ?? null;

    return {
      total:
        transactionAnalytics?.total ?? transactions.length,
      completed,
      failed,
      pending,
      volume,
    };
  }, [transactionAnalytics, transactions]);

  function clearError() {
    setError(null);
  }

  function renderOverview() {
    return (
      <div className="dashboard-content">
        <div className="page-heading">
          <div>
            <div className="eyebrow">
              FINANCIAL CONTROL CENTER
            </div>

            <h1>
              Welcome back, {user?.firstName ?? "there"}.
            </h1>

            <p>
              Monitor and operate{" "}
              {organization?.name ?? "your organization"}.
            </p>
          </div>

          <div className="live-indicator">
            <span className="live-dot" />
            LIVE
          </div>
        </div>

        <div className="overview-grid">
          <Metric
            label="PAYMENTS"
            value="0"
            meta="0% success rate"
          />

          <Metric
            label="PAYMENT VOLUME"
            value={`${organization?.defaultCurrency ?? "NGN"} 0.00`}
            meta="0 completed"
          />

          <Metric
            label="TRANSACTIONS"
            value={transactionSummary.total}
            meta="Financial activity"
          />

          <Metric
            label="ACCOUNTS"
            value={accounts.length}
            meta="Balance tracked"
          />
        </div>

        <div className="content-grid two-column">
          <section className="section-panel">
            <div className="panel-header">
              <div>
                <div className="eyebrow">SYSTEM STATUS</div>
                <h2>Financial services connected</h2>
              </div>

              <div className="panel-icon success">
                <CheckCircle2 size={18} />
              </div>
            </div>

            <div className="system-status">
              <div className="system-status-copy">
                <span className="status-dot online" />
                <span>
                  API and financial services connected
                </span>
              </div>

              <span className="status status-success">
                SYSTEM ONLINE
              </span>
            </div>
          </section>

          <section className="section-panel">
            <div className="panel-header">
              <div>
                <div className="eyebrow">ORGANIZATION</div>
                <h2>
                  {organization?.name ?? "No organization"}
                </h2>
              </div>

              <div className="panel-icon">
                <CircleDollarSign size={18} />
              </div>
            </div>

            <div className="organization-detail">
              <div>
                <span className="detail-label">SLUG</span>
                <strong>
                  {organization?.slug ?? "—"}
                </strong>
              </div>

              <div>
                <span className="detail-label">
                  DEFAULT CURRENCY
                </span>
                <strong>
                  {organization?.defaultCurrency ?? "—"}
                </strong>
              </div>

              <div>
                <span className="detail-label">SOURCE</span>
                <strong>LIVE API</strong>
              </div>
            </div>
          </section>
        </div>
      </div>
    );
  }

  function renderAccounts() {
    const totalBalance = accounts.reduce(
      (sum, account) => sum + Number(account.balance || 0),
      0,
    );

    const activeAccounts = accounts.filter(
      (account) => account.isActive,
    ).length;

    const currencies = new Set(
      accounts.map((account) => account.currency),
    ).size;

    return (
      <div className="dashboard-content">
        <div className="page-heading">
          <div>
            <div className="eyebrow">
              ACCOUNT INFRASTRUCTURE
            </div>
            <h1>Accounts</h1>
            <p>
              Manage the accounts that power your financial
              ledger.
            </p>
          </div>

          <button
            className="secondary-action"
            onClick={() => setActive("Transactions")}
          >
            View transactions
            <ChevronRight size={15} />
          </button>
        </div>

        <div className="overview-grid">
          <Metric
            label="TOTAL ACCOUNTS"
            value={accounts.length}
            meta="Registered accounts"
          />

          <Metric
            label="TOTAL BALANCE"
            value={formatMoney(
              totalBalance,
              organization?.defaultCurrency ?? "NGN",
            )}
            meta="Across registered accounts"
          />

          <Metric
            label="ACTIVE ACCOUNTS"
            value={activeAccounts}
            meta="Operational"
          />

          <Metric
            label="CURRENCIES"
            value={currencies}
            meta="Supported currencies"
          />
        </div>

        <section className="section-panel">
          <div className="panel-header">
            <div>
              <div className="eyebrow">ACCOUNT REGISTER</div>
              <h2>Ledger accounts</h2>
            </div>

            <div className="panel-icon">
              <Users size={18} />
            </div>
          </div>

          {moduleLoading ? (
            <LoadingState label="Loading accounts..." />
          ) : accounts.length === 0 ? (
            <EmptyState
              icon={<Users size={28} />}
              title="No accounts yet"
              description="Accounts created for this organization will appear here."
            />
          ) : (
            <div className="table-wrap">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>ACCOUNT</th>
                    <th>TYPE</th>
                    <th>CURRENCY</th>
                    <th>BALANCE</th>
                    <th>STATUS</th>
                  </tr>
                </thead>

                <tbody>
                  {accounts.map((account) => (
                    <tr key={account.id}>
                      <td>
                        <div className="table-primary">
                          {account.name}
                        </div>
                        <div className="table-secondary">
                          {account.code}
                        </div>
                      </td>

                      <td>{account.type}</td>
                      <td>{account.currency}</td>

                      <td className="amount-cell">
                        {formatMoney(
                          account.balance,
                          account.currency,
                        )}
                      </td>

                      <td>
                        <span
                          className={
                            account.isActive
                              ? "status status-success"
                              : "status status-danger"
                          }
                        >
                          {account.isActive
                            ? "Active"
                            : "Inactive"}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    );
  }

  function renderTransactions() {
    const currency =
      transactionSummary.volume?.[0] ??
      organization?.defaultCurrency ??
      "NGN";

    const volume =
      transactionSummary.volume?.[1] ?? "0";

    return (
      <div className="dashboard-content">
        <div className="page-heading">
          <div>
            <div className="eyebrow">
              TRANSACTION OPERATIONS
            </div>
            <h1>Transactions</h1>
            <p>
              Monitor financial movement across the VOLTIS
              ledger.
            </p>
          </div>

          <div className="live-indicator">
            <span className="live-dot" />
            LIVE DATA
          </div>
        </div>

        <div className="overview-grid">
          <Metric
            label="TOTAL TRANSACTIONS"
            value={transactionSummary.total}
            meta="Recorded operations"
          />

          <Metric
            label="TRANSACTION VOLUME"
            value={formatMoney(volume, currency)}
            meta="Across transaction currencies"
          />

          <Metric
            label="COMPLETED"
            value={transactionSummary.completed}
            meta="Successfully processed"
          />

          <Metric
            label="PENDING / FAILED"
            value={
              transactionSummary.pending +
              transactionSummary.failed
            }
            meta={`${transactionSummary.pending} pending · ${transactionSummary.failed} failed`}
          />
        </div>

        <section className="section-panel">
          <div className="panel-header">
            <div>
              <div className="eyebrow">
                TRANSACTION REGISTER
              </div>
              <h2>Recent financial activity</h2>
            </div>

            <div className="panel-meta">
              <Activity size={15} />
              {transactionSummary.total} records
            </div>
          </div>

          {moduleLoading ? (
            <LoadingState label="Loading transactions..." />
          ) : transactions.length === 0 ? (
            <EmptyState
              icon={<FileText size={28} />}
              title="No transactions yet"
              description="Financial transactions created for this organization will appear here."
            />
          ) : (
            <div className="table-wrap">
              <table className="data-table transactions-table">
                <thead>
                  <tr>
                    <th>REFERENCE</th>
                    <th>TYPE</th>
                    <th>STATUS</th>
                    <th>AMOUNT</th>
                    <th>DESCRIPTION</th>
                    <th>CREATED</th>
                  </tr>
                </thead>

                <tbody>
                  {transactions.map((transaction) => (
                    <tr key={transaction.id}>
                      <td>
                        <div className="table-primary">
                          {transaction.reference}
                        </div>
                        <div className="table-secondary">
                          {transaction.id}
                        </div>
                      </td>

                      <td>{transaction.type}</td>

                      <td>
                        <span
                          className={statusClass(
                            transaction.status,
                          )}
                        >
                          {prettyStatus(
                            transaction.status,
                          )}
                        </span>
                      </td>

                      <td className="amount-cell">
                        {formatMoney(
                          transaction.amount,
                          transaction.currency,
                        )}
                      </td>

                      <td>
                        <span className="description-cell">
                          {transaction.description || "—"}
                        </span>
                      </td>

                      <td className="date-cell">
                        {formatDate(transaction.createdAt)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {!moduleLoading && transactions.length > 0 && (
          <div className="transaction-health">
            <div className="health-title">
              <Activity size={16} />
              Transaction engine operational
            </div>

            <div className="health-items">
              <span>
                <CheckCircle2 size={14} />
                {transactionSummary.completed} completed
              </span>

              <span>
                <XCircle size={14} />
                {transactionSummary.failed} failed
              </span>

              <span>
                <ArrowDownLeft size={14} />
                {transactionSummary.pending} pending
              </span>
            </div>
          </div>
        )}
      </div>
    );
  }

  function renderPlaceholder(module: ActiveModule) {
    const icons = {
      Payments: CreditCard,
      Ledger: BookOpen,
      Reconciliation: RefreshCw,
      Risk: ShieldCheck,
      Webhooks: Webhook,
      Analytics: BarChart3,
      Settings,
    };

    const Icon = icons[module as keyof typeof icons] ?? Activity;

    return (
      <div className="dashboard-content">
        <div className="page-heading">
          <div>
            <div className="eyebrow">
              VOLTIS CONTROL PLANE
            </div>
            <h1>{module}</h1>
            <p>
              Operational control for your financial
              infrastructure.
            </p>
          </div>
        </div>

        <section className="section-panel module-preview">
          <div className="module-preview-icon">
            <Icon size={25} />
          </div>

          <div>
            <div className="eyebrow">MODULE</div>
            <h2>{module}</h2>
            <p>
              Backend integration is ready for the next
              implementation stage.
            </p>
          </div>
        </section>
      </div>
    );
  }

  if (authLoading || loading) {
    return (
      <main className="app-loading">
        <div className="loading-mark">V</div>
        <span>Loading VOLTIS...</span>
      </main>
    );
  }

  if (!user) return null;

  return (
    <main className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">V</div>

          <div className="brand-copy">
            <div className="brand-name">VOLTIS</div>
            <div className="brand-subtitle">
              FINANCIAL INFRASTRUCTURE
            </div>
          </div>
        </div>

        <nav className="navigation">
          {navigation.map((section) => (
            <div className="nav-section" key={section.section}>
              <div className="nav-section-title">
                {section.section}
              </div>

              <div className="nav-items">
                {section.items.map((item) => {
                  const Icon = item.icon;
                  const selected = active === item.label;

                  return (
                    <button
                      type="button"
                      key={item.label}
                      className={`nav-item ${
                        selected ? "active" : ""
                      }`}
                      onClick={() => {
                        clearError();
                        setActive(item.label);
                      }}
                    >
                      <span className="nav-icon">
                        <Icon size={17} strokeWidth={1.8} />
                      </span>

                      <span className="nav-label">
                        {item.label}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <button
            type="button"
            className={`nav-item ${
              active === "Settings" ? "active" : ""
            }`}
            onClick={() => {
              clearError();
              setActive("Settings");
            }}
          >
            <span className="nav-icon">
              <Settings size={17} strokeWidth={1.8} />
            </span>

            <span className="nav-label">Settings</span>
          </button>

          <button
            type="button"
            className="theme-toggle"
            onClick={() =>
              setTheme((current) =>
                current === "dark" ? "light" : "dark",
              )
            }
          >
            <SlidersHorizontal size={16} />
            <span>
              {theme === "dark"
                ? "Light theme"
                : "Dark theme"}
            </span>
          </button>

          <div className="sidebar-user">
            <div className="user-avatar">
              {(user.firstName?.[0] ?? "U").toUpperCase()}
            </div>

            <div className="user-details">
              <strong>
                {user.firstName} {user.lastName}
              </strong>
              <span>{user.email}</span>
            </div>

            <button
              type="button"
              className="logout-button"
              onClick={logout}
              aria-label="Sign out"
            >
              <LogOut size={15} />
            </button>
          </div>
        </div>
      </aside>

      <section className="main-area">
        <header className="topbar">
          <div className="topbar-left">
            <span className="topbar-product">VOLTIS</span>
            <span className="topbar-divider">/</span>
            <span className="topbar-current">{active}</span>
          </div>

          <div className="topbar-right">
            <span className="environment-badge">
              DEVELOPMENT
            </span>

            <span className="api-status">
              <span className="api-dot" />
              API CONNECTED
            </span>
          </div>
        </header>

        {error && (
          <div className="global-error">
            <div className="error-content">
              <XCircle size={16} />
              <span>{error}</span>
            </div>

            <button
              type="button"
              onClick={clearError}
            >
              Dismiss
            </button>
          </div>
        )}

        {active === "Overview"
          ? renderOverview()
          : active === "Accounts"
            ? renderAccounts()
            : active === "Transactions"
              ? renderTransactions()
              : renderPlaceholder(active)}
      </section>
    </main>
  );
}

function Metric({
  label,
  value,
  meta,
}: {
  label: string;
  value: string | number;
  meta: string;
}) {
  return (
    <div className="metric-card">
      <div className="metric-label">{label}</div>
      <div className="metric-value">{value}</div>
      <div className="metric-meta">{meta}</div>
    </div>
  );
}

function LoadingState({ label }: { label: string }) {
  return (
    <div className="empty-state">
      <RefreshCw size={25} className="spin" />
      <strong>{label}</strong>
      <span>Fetching live data from the VOLTIS API.</span>
    </div>
  );
}

function EmptyState({
  icon,
  title,
  description,
}: {
  icon: React.ReactNode;
  title: string;
  description: string;
}) {
  return (
    <div className="empty-state">
      <div className="empty-icon">{icon}</div>
      <strong>{title}</strong>
      <span>{description}</span>
    </div>
  );
}

