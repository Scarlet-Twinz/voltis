"use client";

import { useEffect, useState } from "react";
import {
  Activity,
  BarChart3,
  BookOpen,
  ChevronLeft,
  ChevronRight,
  CreditCard,
  FileCheck2,
  LayoutDashboard,
  LogOut,
  Moon,
  Radio,
  RefreshCw,
  Settings,
  ShieldCheck,
  Sun,
  Webhook,
  Wallet,
} from "lucide-react";
import { useRouter } from "next/navigation";

import {
  api,
  type Account,
  type Organization,
  type OverviewData,
} from "../lib/api";
import { useAuth } from "./AuthProvider";

const navigation = [
  { label: "Overview", icon: LayoutDashboard },
  { label: "Accounts", icon: Wallet },
  { label: "Transactions", icon: Activity },
  { label: "Payments", icon: CreditCard },
  { label: "Ledger", icon: BookOpen },
  { label: "Reconciliation", icon: FileCheck2 },
  { label: "Risk", icon: ShieldCheck },
  { label: "Webhooks", icon: Webhook },
  { label: "Analytics", icon: BarChart3 },
];

function formatNumber(value: number) {
  return new Intl.NumberFormat("en-US").format(value);
}

function formatMoney(value: string, currency: string) {
  const amount = Number(value);

  if (!Number.isFinite(amount)) {
    return `${currency} ${value}`;
  }

  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency,
    maximumFractionDigits: 2,
  }).format(amount);
}

export default function DashboardShell() {
  const router = useRouter();
  const { user, logout } = useAuth();

  const [collapsed, setCollapsed] = useState(false);
  const [active, setActive] = useState("Overview");
  const [lightMode, setLightMode] = useState(false);

  const [organization, setOrganization] =
    useState<Organization | null>(null);

  const [overview, setOverview] =
    useState<OverviewData | null>(null);

  const [accounts, setAccounts] = useState<Account[]>([]);

  const [loading, setLoading] = useState(true);
  const [moduleLoading, setModuleLoading] = useState(false);
  const [creatingOrganization, setCreatingOrganization] =
    useState(false);
  const [error, setError] = useState("");

  const [organizationName, setOrganizationName] = useState("");
  const [organizationSlug, setOrganizationSlug] = useState("");
  const [currency, setCurrency] = useState("NGN");

  useEffect(() => {
    const savedTheme =
      window.localStorage.getItem("voltis_theme");

    if (savedTheme === "light") {
      setLightMode(true);
      document.documentElement.classList.add("light");
    }
  }, []);

  useEffect(() => {
    loadOrganization();
  }, []);

  useEffect(() => {
    if (organization && active === "Accounts") {
      loadAccounts(organization.id);
    }
  }, [active, organization]);

  async function loadOrganization() {
    setLoading(true);
    setError("");

    try {
      const organizations = await api.organizations.list();

      if (organizations.length === 0) {
        setOrganization(null);
        setOverview(null);
        setAccounts([]);
        return;
      }

      const currentOrganization = organizations[0];

      setOrganization(currentOrganization);

      const data = await api.analytics.overview(
        currentOrganization.id,
      );

      setOverview(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load organization data.",
      );
    } finally {
      setLoading(false);
    }
  }

  async function loadAccounts(organizationId: string) {
    setModuleLoading(true);
    setError("");

    try {
      const data = await api.accounts.list(
        organizationId,
      );

      setAccounts(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load accounts.",
      );
    } finally {
      setModuleLoading(false);
    }
  }

  async function handleCreateOrganization(
    event: React.FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    setError("");
    setCreatingOrganization(true);

    try {
      const created = await api.organizations.create({
        name: organizationName.trim(),
        slug: organizationSlug.trim().toLowerCase(),
        defaultCurrency: currency,
      });

      setOrganization(created);

      const data = await api.analytics.overview(
        created.id,
      );

      setOverview(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to create organization.",
      );
    } finally {
      setCreatingOrganization(false);
    }
  }

  function toggleTheme() {
    setLightMode((current) => {
      const next = !current;

      if (next) {
        document.documentElement.classList.add("light");
        window.localStorage.setItem(
          "voltis_theme",
          "light",
        );
      } else {
        document.documentElement.classList.remove(
          "light",
        );
        window.localStorage.setItem(
          "voltis_theme",
          "dark",
        );
      }

      return next;
    });
  }

  function handleLogout() {
    logout();
    router.replace("/login");
  }

  const displayName =
    user?.firstName || user?.lastName
      ? `${user.firstName} ${user.lastName}`.trim()
      : "VOLTIS User";

  const initials =
    `${user?.firstName?.[0] ?? ""}${user?.lastName?.[0] ?? ""}`.toUpperCase() ||
    "V";

  const currencyCode =
    overview?.organization.defaultCurrency ??
    organization?.defaultCurrency ??
    "NGN";

  function renderAccounts() {
    if (moduleLoading) {
      return (
        <div className="dashboard-loading">
          <RefreshCw
            size={20}
            className="loading-icon"
          />
          <span>Loading account infrastructure...</span>
        </div>
      );
    }

    if (error) {
      return (
        <div className="dashboard-error">
          <div>
            <div className="eyebrow">
              DATA CONNECTION
            </div>

            <h2>Unable to load accounts</h2>

            <p>{error}</p>
          </div>

          <button
            className="secondary-button"
            onClick={() =>
              organization &&
              loadAccounts(organization.id)
            }
          >
            <RefreshCw size={15} />
            Retry
          </button>
        </div>
      );
    }

    return (
      <>
        <div className="welcome">
          <div>
            <div className="eyebrow">
              ACCOUNT INFRASTRUCTURE
            </div>

            <h2>Accounts</h2>

            <p>
              Monitor balances and financial accounts
              belonging to {organization?.name}.
            </p>
          </div>

          <div className="organization-summary">
            <span>{organization?.slug}</span>
            <strong>{currencyCode}</strong>
          </div>
        </div>

        <div className="dashboard-grid">
          <article className="metric-card">
            <div className="metric-label">
              TOTAL ACCOUNTS
            </div>

            <div className="metric-value">
              {formatNumber(accounts.length)}
            </div>

            <div className="metric-meta">
              Active financial accounts
            </div>
          </article>

          <article className="metric-card">
            <div className="metric-label">
              TOTAL BALANCE
            </div>

            <div className="metric-value metric-money">
              {formatMoney(
                accounts
                  .reduce(
                    (sum, account) =>
                      sum + Number(account.balance),
                    0,
                  )
                  .toFixed(2),
                currencyCode,
              )}
            </div>

            <div className="metric-meta">
              Across all accounts
            </div>
          </article>

          <article className="metric-card">
            <div className="metric-label">
              ACTIVE
            </div>

            <div className="metric-value">
              {
                accounts.filter(
                  (account) => account.isActive,
                ).length
              }
            </div>

            <div className="metric-meta">
              Operational accounts
            </div>
          </article>

          <article className="metric-card">
            <div className="metric-label">
              CURRENCIES
            </div>

            <div className="metric-value">
              {
                new Set(
                  accounts.map(
                    (account) => account.currency,
                  ),
                ).size
              }
            </div>

            <div className="metric-meta">
              Supported account currencies
            </div>
          </article>
        </div>

        <div className="dashboard-panel accounts-panel">
          <div className="panel-header">
            <div>
              <div className="eyebrow">
                ACCOUNT REGISTER
              </div>

              <h3>Financial accounts</h3>

              <p>
                Double-entry accounts registered under
                this organization.
              </p>
            </div>

            <div className="panel-status">
              <span className="status-dot" />
              Live API data
            </div>
          </div>

          {accounts.length === 0 ? (
            <div className="empty-state">
              <Wallet size={28} />

              <strong>No accounts yet</strong>

              <span>
                Financial accounts will appear here once
                they are created through the VOLTIS API.
              </span>
            </div>
          ) : (
            <div className="account-table">
              <div className="account-row account-row-header">
                <span>ACCOUNT</span>
                <span>TYPE</span>
                <span>CURRENCY</span>
                <span>BALANCE</span>
                <span>STATUS</span>
              </div>

              {accounts.map((account) => (
                <div
                  className="account-row"
                  key={account.id}
                >
                  <div>
                    <strong>{account.name}</strong>
                    <span>{account.code}</span>
                  </div>

                  <span>{account.type}</span>

                  <span>{account.currency}</span>

                  <strong>
                    {formatMoney(
                      account.balance,
                      account.currency,
                    )}
                  </strong>

                  <span
                    className={
                      account.isActive
                        ? "account-status"
                        : "account-status inactive"
                    }
                  >
                    {account.isActive
                      ? "ACTIVE"
                      : "INACTIVE"}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      </>
    );
  }

  return (
    <div
      className={`dashboard-shell ${
        collapsed ? "collapsed" : ""
      }`}
    >
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">V</div>

          {!collapsed && (
            <div>
              <div className="brand-name">VOLTIS</div>
              <div className="brand-subtitle">
                Financial Infrastructure
              </div>
            </div>
          )}
        </div>

        <button
          className="sidebar-toggle"
          onClick={() =>
            setCollapsed((value) => !value)
          }
          aria-label={
            collapsed
              ? "Expand sidebar"
              : "Collapse sidebar"
          }
        >
          {collapsed ? (
            <ChevronRight size={17} />
          ) : (
            <ChevronLeft size={17} />
          )}
        </button>

        <nav className="navigation">
          <div className="nav-section">
            {!collapsed && "PLATFORM"}
          </div>

          {navigation.map((item) => {
            const Icon = item.icon;
            const isActive = active === item.label;

            return (
              <button
                key={item.label}
                className={`nav-item ${
                  isActive ? "active" : ""
                }`}
                onClick={() => {
                  setError("");
                  setActive(item.label);
                }}
                title={
                  collapsed
                    ? item.label
                    : undefined
                }
              >
                <Icon
                  size={17}
                  strokeWidth={1.8}
                />

                {!collapsed && (
                  <span>{item.label}</span>
                )}
              </button>
            );
          })}
        </nav>

        <div className="sidebar-bottom">
          <button className="nav-item">
            <Radio size={17} strokeWidth={1.8} />

            {!collapsed && (
              <>
                <span>System Status</span>
                <span className="status-dot" />
              </>
            )}
          </button>

          <button className="nav-item">
            <Settings
              size={17}
              strokeWidth={1.8}
            />

            {!collapsed && (
              <span>Settings</span>
            )}
          </button>

          <button
            className="nav-item"
            onClick={toggleTheme}
            title={
              collapsed
                ? "Toggle theme"
                : undefined
            }
          >
            {lightMode ? (
              <Moon size={17} strokeWidth={1.8} />
            ) : (
              <Sun size={17} strokeWidth={1.8} />
            )}

            {!collapsed && (
              <span>
                {lightMode
                  ? "Dark mode"
                  : "Light mode"}
              </span>
            )}
          </button>

          <button
            className="nav-item"
            onClick={handleLogout}
            title={
              collapsed
                ? "Sign out"
                : undefined
            }
          >
            <LogOut
              size={17}
              strokeWidth={1.8}
            />

            {!collapsed && (
              <span>Sign out</span>
            )}
          </button>
        </div>
      </aside>

      <main className="dashboard-main">
        <header className="topbar">
          <div className="topbar-title">
            <div className="eyebrow">
              OPERATIONS
            </div>

            <h1>{active}</h1>
          </div>

          <div className="topbar-right">
            {organization && (
              <div className="organization-chip">
                {organization.name}
              </div>
            )}

            <div className="environment">
              <span className="status-dot" />
              Development
            </div>

            <div className="user-chip">
              <div className="user-avatar">
                {initials}
              </div>

              <div>
                <div className="user-name">
                  {displayName}
                </div>

                <div className="user-role">
                  {user?.email ??
                    "Authenticated user"}
                </div>
              </div>
            </div>
          </div>
        </header>

        <section className="dashboard-content">
          {loading ? (
            <div className="dashboard-loading">
              <RefreshCw
                size={20}
                className="loading-icon"
              />

              <span>
                Loading financial infrastructure...
              </span>
            </div>
          ) : !organization ? (
            <div className="organization-setup">
              <div className="eyebrow">
                GET STARTED
              </div>

              <h2>
                Create your organization
              </h2>

              <p>
                Your VOLTIS account is ready. Create an
                organization to activate your financial
                control center.
              </p>

              <form
                onSubmit={
                  handleCreateOrganization
                }
                className="organization-form"
              >
                <label>
                  <span>Organization name</span>

                  <input
                    type="text"
                    value={organizationName}
                    onChange={(event) =>
                      setOrganizationName(
                        event.target.value,
                      )
                    }
                    placeholder="Acme Payments"
                    minLength={2}
                    maxLength={150}
                    required
                  />
                </label>

                <label>
                  <span>Organization slug</span>

                  <input
                    type="text"
                    value={organizationSlug}
                    onChange={(event) =>
                      setOrganizationSlug(
                        event.target.value
                          .toLowerCase()
                          .replace(
                            /[^a-z0-9-]/g,
                            "-",
                          ),
                      )
                    }
                    placeholder="acme-payments"
                    minLength={3}
                    maxLength={100}
                    required
                  />
                </label>

                <label>
                  <span>Default currency</span>

                  <select
                    value={currency}
                    onChange={(event) =>
                      setCurrency(
                        event.target.value,
                      )
                    }
                  >
                    <option value="NGN">
                      NGN — Nigerian Naira
                    </option>

                    <option value="USD">
                      USD — US Dollar
                    </option>

                    <option value="EUR">
                      EUR — Euro
                    </option>

                    <option value="GBP">
                      GBP — British Pound
                    </option>
                  </select>
                </label>

                {error && (
                  <div className="auth-error">
                    {error}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={
                    creatingOrganization
                  }
                >
                  {creatingOrganization
                    ? "Creating organization..."
                    : "Create organization"}
                </button>
              </form>
            </div>
          ) : active === "Accounts" ? (
            renderAccounts()
          ) : active !== "Overview" ? (
            <div className="welcome">
              <div>
                <div className="eyebrow">
                  VOLTIS PLATFORM
                </div>

                <h2>{active}</h2>

                <p>
                  This module is connected to the VOLTIS
                  platform and is ready for its
                  operational interface.
                </p>
              </div>
            </div>
          ) : error ? (
            <div className="dashboard-error">
              <div>
                <div className="eyebrow">
                  DATA CONNECTION
                </div>

                <h2>
                  Unable to load dashboard data
                </h2>

                <p>{error}</p>
              </div>

              <button
                className="secondary-button"
                onClick={loadOrganization}
              >
                <RefreshCw size={15} />
                Retry
              </button>
            </div>
          ) : (
            <>
              <div className="welcome">
                <div>
                  <div className="eyebrow">
                    FINANCIAL CONTROL CENTER
                  </div>

                  <h2>
                    Welcome back
                    {user?.firstName
                      ? `, ${user.firstName}.`
                      : "."}
                  </h2>

                  <p>
                    Monitor and operate{" "}
                    <strong>
                      {organization.name}
                    </strong>{" "}
                    from one unified financial control
                    surface.
                  </p>
                </div>

                <div className="organization-summary">
                  <span>{organization.slug}</span>

                  <strong>{currencyCode}</strong>
                </div>
              </div>

              <div className="dashboard-grid">
                <article className="metric-card">
                  <div className="metric-label">
                    PAYMENTS
                  </div>

                  <div className="metric-value">
                    {formatNumber(
                      overview?.payments.total ?? 0,
                    )}
                  </div>

                  <div className="metric-meta">
                    {overview?.payments.successRate ??
                      0}
                    % success rate
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    PAYMENT VOLUME
                  </div>

                  <div className="metric-value metric-money">
                    {formatMoney(
                      overview?.payments.volume ??
                        "0",
                      currencyCode,
                    )}
                  </div>

                  <div className="metric-meta">
                    {overview?.payments.completed ??
                      0}{" "}
                    completed
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    TRANSACTIONS
                  </div>

                  <div className="metric-value">
                    {formatNumber(
                      overview?.transactions
                        .total ?? 0,
                    )}
                  </div>

                  <div className="metric-meta">
                    {overview?.transactions.completed ??
                      0}{" "}
                    completed
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    ACCOUNTS
                  </div>

                  <div className="metric-value">
                    {formatNumber(
                      overview?.accounts.total ?? 0,
                    )}
                  </div>

                  <div className="metric-meta">
                    Balance{" "}
                    {formatMoney(
                      overview?.accounts.balance ??
                        "0",
                      currencyCode,
                    )}
                  </div>
                </article>
              </div>

              <div className="dashboard-grid dashboard-grid-secondary">
                <article className="metric-card">
                  <div className="metric-label">
                    LEDGER
                  </div>

                  <div
                    className={`metric-value status-value ${
                      overview?.ledger.balanced
                        ? ""
                        : "danger-value"
                    }`}
                  >
                    {overview?.ledger.balanced
                      ? "BALANCED"
                      : "IMBALANCED"}
                  </div>

                  <div className="metric-meta">
                    Debits{" "}
                    {formatMoney(
                      overview?.ledger.debits ??
                        "0",
                      currencyCode,
                    )}
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    RISK
                  </div>

                  <div className="metric-value">
                    {formatNumber(
                      overview?.risk.total ?? 0,
                    )}
                  </div>

                  <div className="metric-meta">
                    Average score{" "}
                    {overview?.risk.averageScore ??
                      0}
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    RECONCILIATION
                  </div>

                  <div className="metric-value">
                    {formatNumber(
                      overview?.reconciliation
                        .completed ?? 0,
                    )}
                  </div>

                  <div className="metric-meta">
                    of{" "}
                    {overview?.reconciliation
                      .total ?? 0}{" "}
                    runs completed
                  </div>
                </article>

                <article className="metric-card">
                  <div className="metric-label">
                    SYSTEM
                  </div>

                  <div className="metric-value status-value">
                    ONLINE
                  </div>

                  <div className="metric-meta">
                    API and financial services connected
                  </div>
                </article>
              </div>

              <div className="dashboard-panel">
                <div>
                  <div className="eyebrow">
                    ORGANIZATION
                  </div>

                  <h3>{organization.name}</h3>

                  <p>
                    {organization.slug} · Default
                    currency {currencyCode}
                  </p>
                </div>

                <div className="panel-status">
                  <span className="status-dot" />
                  Live API data
                </div>
              </div>
            </>
          )}
        </section>
      </main>
    </div>
  );
}
